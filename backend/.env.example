# MongoDB (use a MongoDB Atlas connection string for Vercel)
MONGO_URL=mongodb://localhost:27017
DB_NAME=disaster_command

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false        # set to true (or remove) in production over HTTPS
COOKIE_SAMESITE=lax

# Seeded admin account
ADMIN_EMAIL=admin@rescue.io
ADMIN_PASSWORD=change-me

# Optional: extra allowed CORS origins (comma-separated); only needed if frontend is on another domain
FRONTEND_URL=http://localhost:3000

# Optional: enables live AI analysis + chat (falls back to offline mode when empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
